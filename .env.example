# Connection string from your Neon project (use the "pooled connection" one).
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/owstats?sslmode=require

# Shared secret the /api/poll endpoint requires as `Authorization: Bearer <value>`.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Battletags of the two players, with '#' replaced by '-' (OverFast's format).
PLAYER_1=Nick-1234
PLAYER_2=Nick-5678

# Optional display names shown in the UI. Defaults to the part before '-' in
# PLAYER_1 / PLAYER_2 if omitted.
PLAYER_1_LABEL=
PLAYER_2_LABEL=
